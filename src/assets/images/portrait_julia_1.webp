<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Rub Rankings – Quick Check-In</title>
<style>
  :root {
    --purple: #7b2ee6; --purple-dark: #6421c4; --pink: #e8457c;
    --bg: #1c1c1c; --top: #0e0e0e; --line: #333;
    --text: #ffffff; --muted: #c4c0c8;
    --skin: #c9a38a; --skin-shade: #b08a72; --hand: #e2bfa6; --hand-shade: #cfa88e;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0; min-height: 100vh; display: flex; flex-direction: column;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--text);
    background: radial-gradient(ellipse at 50% 45%, rgba(123,46,230,.22) 0%, rgba(123,46,230,0) 55%), var(--bg);
  }
  header { background: var(--top); border-bottom: 1px solid var(--line); padding: 16px; text-align: center; }
  header img { height: 46px; width: auto; }
  .notice { color: var(--pink); font-size: .95rem; margin-top: 6px; }
  main { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
          text-align: center; padding: 28px 16px 32px; }
  main { justify-content: flex-start; }
  .scene { width: 460px; max-width: 92vw; height: auto; overflow: visible; margin-bottom: 18px; }
  h1 { font-size: clamp(1.8rem, 4.5vw, 2.6rem); margin: 6px 0 14px; font-weight: 600; }
  p { font-size: clamp(1rem, 2.2vw, 1.15rem); line-height: 1.6; margin: 0 auto 12px; color: var(--muted); max-width: 560px; }
  .btn { display: inline-block; margin-top: 14px; padding: 14px 38px; border-radius: 4px; background: var(--purple);
          color: #fff; text-decoration: none; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .btn:hover { background: var(--purple-dark); }
  .small { font-size: .85rem; margin-top: 22px; color: #9a96a0; }
  .challenge { margin: 8px auto 22px; display: flex; justify-content: center; min-height: 70px; }
  .cf { display: none; }

  .scene { width: 360px; margin: 0 0 4px; }
  /* leg massage animation */
  .scene { overflow: hidden; }
  .hands { animation: glide 3.4s ease-in-out infinite; }
  .squeeze { transform-origin: 194px 90px; animation: sq 1.7s ease-in-out infinite; }
  .calf { transform-origin: 190px 139px; animation: knead 1.7s ease-in-out infinite; }
  .press-glow { animation: pg 1.7s ease-in-out infinite; }
  @keyframes glide { 0%, 100% { transform: translateX(-34px); } 50% { transform: translateX(34px); } }
  @keyframes sq { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(3px) scaleX(1.02); } }
  @keyframes knead { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(.985); } }
  @keyframes pg { 0%, 100% { opacity: .3; } 50% { opacity: .8; } }
  @media (prefers-reduced-motion: reduce) { .hands, .squeeze, .calf, .press-glow { animation: none; } }
</style>
<meta http-equiv="refresh" content="360"></head>
<body>
  <header>
    <img src="data:image/webp;base64," alt="Rub Rankings">
    <div class="notice">Quick security check</div>
  </header>
  <main>
    <h1>Just a quick check-in</h1>
    <p>Before your session begins, please confirm you're a real person. It only takes a moment.</p>
